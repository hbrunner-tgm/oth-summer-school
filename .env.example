# Hedera Testnet credentials.
# Create free Testnet accounts at https://portal.hedera.com/
# Copy this file to ".env" and fill in your values. (.env is gitignored.)

# --- Admin / contract owner -------------------------------------------------
# This account deploys the contract, so it becomes the owner and is the only
# one that can blacklist accounts and open/close voting.
HEDERA_OPERATOR_ID=x
HEDERA_OPERATOR_KEY=x

# --- Deployed contract ------------------------------------------------------
# Filled in after `node deploy.js`. Read by call.js and results.js so you don't
# have to pass --contract every time.
CONTRACT_ID=0.0.xxxxx

# --- Voters -----------------------------------------------------------------
# Any number of extra accounts, one <LABEL>_ID / <LABEL>_KEY pair each. The
# label becomes the --as flag:  node call.js --as voter1 ...
# ECDSA keys are recommended: they have an EVM alias address, ED25519 keys do not.
VOTER1_ID=0.0.xxxxx
VOTER1_KEY=x

VOTER2_ID=0.0.xxxxx
VOTER2_KEY=x

VOTER3_ID=0.0.xxxxx
VOTER3_KEY=x
